{
  "name": "autolangchat-frontend",
  "private": true,
  "version": "0.0.0",
  "author": "Intel Corporation",
  "license": "ISC",
  "type": "module",
  "ts-node": {
    "esm": true,
    "project": "tests/tsconfig.json",
    "transpileOnly": true
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run --project unit --project component --project contract --project lint",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage --project unit --project component --project contract --project lint",
    "test:e2e": "TS_NODE_PROJECT=tests/tsconfig.json TS_NODE_TRANSPILE_ONLY=true mocha",
    "test:e2e:watch": "TS_NODE_PROJECT=tests/tsconfig.json TS_NODE_TRANSPILE_ONLY=true mocha --watch",
    "test:e2e:soak": "RUN_SOAK=1 TS_NODE_PROJECT=tests/tsconfig.json TS_NODE_TRANSPILE_ONLY=true mocha --grep \"streaming memory soak\"",
    "test:contract": "vitest run --project contract",
    "bench": "vitest run --project bench",
    "check:copy": "node scripts/check-copy-parity.mjs",
    "check:chunks": "node scripts/check-chunk-split.mjs",
    "size": "size-limit",
    "verify": "npm run typecheck && npm run lint && npm run check:copy && npm run test:coverage && npm run bench && npm run build && npm run check:chunks && npm run size"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.17.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/webdriverjs": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@size-limit/preset-app": "^13.0.3",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.30",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/chai": "^5.2.3",
    "@types/jest": "^30.0.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "chai": "^6.2.2",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jsdom": "^30.0.1",
    "mocha": "^11.8.0",
    "msw": "^2.15.0",
    "selenium-webdriver": "^4.47.0",
    "size-limit": "^13.0.3",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.11",
    "vitest-axe": "^0.1.0",
    "ws": "^8.21.3"
  },
  "size-limit": [
    {
      "name": "Chat entry chunk (NFR-PERF-001 caps at 250 KB gzip; re-derived Phase 10 tripwire, measured ~109 KB on the finished app)",
      "path": "dist/assets/index-*.js",
      "limit": "140 KB",
      "gzip": true
    },
    {
      "name": "Global stylesheet (re-derived Phase 10, measured ~17 KB on the finished app)",
      "path": "dist/assets/index-*.css",
      "limit": "24 KB",
      "gzip": true
    },
    {
      "name": "Admin route chunks (FR-SHELL-015, lazy; re-derived Phase 10, measured ~17 KB on the finished app)",
      "path": "dist/assets/admin.*.js",
      "limit": "28 KB",
      "gzip": true
    }
  ]
}
