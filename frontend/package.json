{
  "name": "autolangchat-frontend",
  "private": true,
  "version": "0.0.0",
  "author": "Intel Corporation",
  "license": "ISC",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "jest": "NODE_OPTIONS=\"${NODE_OPTIONS:-} --experimental-vm-modules --no-warnings=ExperimentalWarning\" jest",
    "test": "npm run jest -- --selectProjects unit component contract lint",
    "test:watch": "npm run jest -- --watch --selectProjects unit component contract lint",
    "test:coverage": "npm run jest -- --coverage --selectProjects unit component contract lint",
    "test:e2e": "npm run jest -- --selectProjects e2e",
    "test:e2e:watch": "npm run jest -- --watchAll --selectProjects e2e",
    "test:e2e:soak": "RUN_SOAK=1 npm run jest -- --selectProjects e2e -t \"streaming memory soak\"",
    "test:contract": "npm run jest -- --selectProjects contract",
    "bench": "npm run jest -- --selectProjects bench",
    "check:copy": "node scripts/check-copy-parity.mjs",
    "check:chunks": "node scripts/check-chunk-split.mjs",
    "size": "size-limit",
    "verify": "npm run typecheck && npm run lint && npm run check:copy && npm run test:coverage && npm run bench && npm run build && npm run check:chunks && npm run size"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hookform/resolvers": "^5.7.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "@tanstack/react-virtual": "^3.14.9",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.31.0",
    "next-themes": "^0.4.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-hook-form": "^7.85.0",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "shadcn": "^4.17.0",
    "shiki": "^4.4.3",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/webdriverjs": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@jest/environment-jsdom-abstract": "^30.5.2",
    "@jest/globals": "^30.5.2",
    "@size-limit/preset-app": "^13.0.3",
    "@swc/core": "^1.16.2",
    "@swc/jest": "^0.2.39",
    "@tanstack/react-query-devtools": "^5.101.4",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-plugin": "^1.168.30",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/jest": "^30.0.0",
    "@types/jest-axe": "^3.5.9",
    "@types/node": "^24.13.3",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/selenium-webdriver": "^4.35.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^6.0.4",
    "eslint": "^10.8.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "fast-check": "^4.9.0",
    "globals": "^17.7.0",
    "jest": "^30.5.2",
    "jest-axe": "^11.0.0",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "pixelmatch": "^7.2.0",
    "pngjs": "^7.0.0",
    "selenium-webdriver": "^4.47.0",
    "size-limit": "^13.0.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.2.0",
    "ws": "^8.21.3"
  },
  "size-limit": [
    {
      "name": "Chat entry chunk (NFR-PERF-001 caps at 250 KB gzip; re-derived Phase 10 tripwire, measured ~109 KB on the finished app)",
      "path": "dist/assets/index-*.js",
      "limit": "140 KB",
      "gzip": true
    },
    {
      "name": "Global stylesheet (re-derived Phase 10, measured ~17 KB on the finished app)",
      "path": "dist/assets/index-*.css",
      "limit": "24 KB",
      "gzip": true
    },
    {
      "name": "Admin route chunks (FR-SHELL-015, lazy; re-derived Phase 10, measured ~17 KB on the finished app)",
      "path": "dist/assets/admin.*.js",
      "limit": "28 KB",
      "gzip": true
    }
  ]
}
